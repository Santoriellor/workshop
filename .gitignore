# Secrets
# secrets/README.md documents the directory for readers; it holds no
# credentials itself and must stay tracked. The directory itself cannot be
# excluded with a trailing slash, or git will never look inside it to apply
# the exception below - so its contents are excluded individually instead.
secrets/*
!secrets/README.md

# Python & Django
__pycache__/
*.py[cod]
*.sqlite3
*.log
.env
# front/.env is NOT a secret: it holds only VITE_API_URL, which Vite inlines
# into the public browser bundle. front/Dockerfile copies it at build time,
# so it must stay tracked.
!front/.env
env/
*.bak

# Node.js (React frontend)
node_modules/
*.log
*.cache
.yarn/
.npm/

# OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Gunicorn & Nginx
*.sock
*.pid

# Build & Static Files
staticfiles/
media/
dist/
build/

# Git Credentials
*.pem
*.key