# Copy to back/.env for local development. Never commit back/.env.
# In production these come from /srv/secrets/workshop/back.env via
# docker-compose env_file - see README.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
MYSQL_DATABASE=workshop_db
MYSQL_HOST=mysql
MYSQL_PORT=3306
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-locally
